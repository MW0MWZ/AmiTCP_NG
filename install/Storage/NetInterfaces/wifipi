# AmiTCP_NG interface configuration -- PiStorm WiFi (wifipi.device, ~100 Mbit).
#
# To use: copy this file to DEVS:NetInterfaces/ under the name you want the
# interface to have (e.g. "eth0"), edit if necessary, then reboot (or run
# "AddNetInterface DEVS:NetInterfaces/eth0" from a Shell).

device=wifipi.device
unit=0

# Obtain the IP address, netmask, gateway and DNS servers automatically via DHCP.
configure=dhcp

# WiFi drivers usually need a moment after opening before they will configure.
requiresinitdelay=yes

# --- Performance: size the SANA-II receive/transmit rings for a ~100 Mbit link. ---
# On a fast NIC a burst that overruns the receive ring is dropped at the driver,
# which stalls TCP; a deeper ring absorbs the burst. Each receive request pins one
# MTU-sized buffer (~2 KB), so 192 reads is ~0.4 MB of RAM -- a fair trade for
# throughput on a PiStorm-class machine. Transmit requests are cheap.
#
# Leave these OUT to let AmiTCP_NG auto-size the rings by installed RAM instead.
# These are starting points for ~100 Mbit -- tune to taste.
iprequests=192
writerequests=128

# --- TCP window (optional) -------------------------------------------------------
# You normally DON'T need to set this. AmiTCP_NG auto-tunes the TCP window from the
# NIC's link speed, clamped to what your RAM can back: a ~100 Mbit link like this one
# is sized to ~512 KB automatically. (512 KB tested fastest on real hardware -- a full
# 1 MB window overshoots a 100 Mbit link, so its bandwidth-delay product is exceeded
# and a single loss then retransmits a huge window and sawtooths.) See what the stack
# actually chose with "GetNetStatus DEBUG".
#
# Set these only to force a size -- e.g. if your driver misreports its link speed and
# DEBUG shows the wrong window. They are STACK-WIDE (like Roadshow): they set the
# default for EVERY connection, not just this interface, and persist until reboot --
# and any interface's value overrides, last one configured wins.
# tcp.sendspace=524288    512 KB -- a good ~100 Mbit value.
# tcp.recvspace=524288

# --- Other optional overrides (uncomment only if you need them) ------------------
# mtu=1500              Interface MTU. 1500 is the Ethernet default; only set this to
#                       LOWER it for a link that requires a smaller MTU.
